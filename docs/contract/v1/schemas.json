{
  "auth": {
    "headers": [
      "X-Provider-Id",
      "X-Timestamp",
      "X-Signature",
      "X-Correlation-Id (optional)"
    ],
    "scheme": "HMAC-SHA256 request signature",
    "signed_message": "timestamp \\n METHOD \\n path+query \\n sha256(body) hex",
    "timestamp": "unix seconds; rejected outside the configured window"
  },
  "event_types": [
    "offer.created",
    "offer.updated",
    "offer.withdrawn",
    "offer.expired",
    "booking.cancelled",
    "booking.expired"
  ],
  "operations": {
    "assign_offer": {
      "args": "AssignOfferArgs",
      "executor": "provider_server",
      "idempotency_key": true,
      "result": "AssignmentInfo"
    },
    "create_booking": {
      "args": "CreateBookingArgs",
      "executor": "provider_server",
      "idempotency_key": true,
      "result": "ProviderBooking"
    },
    "estimate_fare": {
      "args": "EstimateFareArgs",
      "executor": "provider_server",
      "idempotency_key": false,
      "result": "FareQuote"
    },
    "get_booking_status": {
      "args": "GetBookingStatusArgs",
      "executor": "provider_server",
      "idempotency_key": false,
      "result": "BookingStatusResult"
    },
    "resolve_address": {
      "args": "ResolveAddressArgs",
      "executor": "provider_server",
      "idempotency_key": false,
      "result": "AddressResolution"
    }
  },
  "outcomes": {
    "rejected": "definite refusal or validation failure; never retried",
    "succeeded": "result required and schema-validated",
    "unavailable": "not processed; retried with backoff",
    "unknown": "may have been processed; retried with the same idempotency key (reconcile=true)"
  },
  "schemas": {
